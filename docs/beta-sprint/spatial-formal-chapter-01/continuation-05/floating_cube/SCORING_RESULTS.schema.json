  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "weight",
        "status",
        "score",
        "weighted_score",
        "evidence_ids",
        "observation",
        "rationale",
        "deduction",
        "unresolved",
        "subjective"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "enum": [
            "ASSESSED",
            "NOT_ASSESSED"
          ]
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "weighted_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "deduction": {
          "type": "string",
          "minLength": 1
        },
        "unresolved": {
          "type": "string",
          "minLength": 1
        },
        "subjective": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_ASSESSED"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
